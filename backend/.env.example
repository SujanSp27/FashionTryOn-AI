# Virtual Try-On Backend Gateway Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (Never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitfusion?retryWrites=true&w=majority

# AI FastAPI Service Endpoint (local or ngrok public URL)
AI_SERVICE_URL=http://127.0.0.1:8000

# CORS Allowed Origin for Frontend (React / Vite)
CORS_ORIGIN=http://localhost:5173

# AI Inference Request Timeout in milliseconds (default: 120000ms / 2 minutes)
AI_REQUEST_TIMEOUT_MS=120000

# Maximum allowed file upload size in MB per image
MAX_FILE_SIZE_MB=10
